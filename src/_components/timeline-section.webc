<script webc:setup>
const timeline = this.timeline || [];
const visible = timeline.filter(e => !e.collapsed);
const hidden = timeline.filter(e => e.collapsed);

function esc(str) { return String(str || "").replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }

function renderEntry(entry, isLast) {
  const borderClass = isLast ? "relative pl-8 border-l-2 border-gray-200" : "relative pl-8 pb-12 border-l-2 border-gray-200";
  const dotColor = entry.dotColor === "gray" ? "bg-gray-400" : "bg-black";
  let detailsHtml = "";
  if (entry.details && entry.details.length) {
    detailsHtml = '<div class="space-y-3">';
    for (const d of entry.details) {
      detailsHtml += '<div>';
      if (d.role) detailsHtml += '<p class="text-gray-700 font-medium mb-1">' + esc(d.role) + '</p>';
      if (d.description) detailsHtml += '<p class="text-gray-600 leading-relaxed">' + esc(d.description) + '</p>';
      detailsHtml += '</div>';
    }
    detailsHtml += '</div>';
  }
  let html = '<div class="' + borderClass + '">';
  html += '<div class="absolute -left-[9px] top-0 w-4 h-4 rounded-full ' + dotColor + '"></div>';
  html += '<p class="caption mb-1">' + esc(entry.period) + '</p>';
  html += '<h3 class="text-xl font-serif font-bold mb-1">' + esc(entry.company) + '</h3>';
  if (entry.subtitle) html += '<p class="text-sm font-medium text-gray-500 uppercase tracking-wide mb-3">' + esc(entry.subtitle) + '</p>';
  html += detailsHtml;
  html += '</div>\n';
  return html;
}

let visibleHtml = visible.map(e => renderEntry(e, false)).join("");
let hiddenHtml = hidden.map((e, i) => renderEntry(e, i === hidden.length - 1)).join("");
</script>
<div id="timeline-container" class="space-y-0">
  <div @raw="visibleHtml"></div>
  <div id="collapsed-timeline" class="timeline-collapsed collapsed" webc:if="hidden.length">
    <div @raw="hiddenHtml"></div>
  </div>
</div>
<button id="expand-timeline" class="mt-6 inline-flex items-center justify-center px-6 py-3 bg-black text-white rounded-lg font-medium btn-primary" webc:if="hidden.length">
  <span>Expand Timeline &darr;</span>
</button>
<button id="collapse-timeline" class="mt-6 hidden inline-flex items-center justify-center px-6 py-3 bg-black text-white rounded-lg font-medium btn-primary" webc:if="hidden.length">
  <span>Collapse Timeline &uarr;</span>
</button>
