<header id="site-header" class="flex flex-col">
  <div class="flex items-center justify-between py-4 px-6">
    <div class="flex items-center space-x-2">
      <a :href="this.navHome || '/'" class="flex items-center space-x-2">
        <span class="text-2xl font-serif font-bold tracking-tight site-logo">DM</span>
        <span class="text-sm font-sans uppercase tracking-wider text-gray-500">Portfolio</span>
      </a>
    </div>
    <nav class="hidden md:flex items-center space-x-4">
      <a :href="this.navHome || '/'" class="nav-link text-sm font-medium hover:opacity-70 transition-opacity">Home</a>
      <a :href="this.navAbout || '/about.html'" class="nav-link text-sm font-medium hover:opacity-70 transition-opacity">About</a>
      <a :href="this.navProjects || '/projects.html'" class="nav-link text-sm font-medium hover:opacity-70 transition-opacity">All Projects</a>
      <a :href="this.navContact || '/contact.html'" class="nav-link text-sm font-medium hover:opacity-70 transition-opacity">Contact</a>
      <a href="javascript:window.print()" class="header-pdf-link" aria-label="Print / Save PDF" onclick="window.print();return false">
        <svg class="header-pdf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        <span>PDF</span>
      </a>
    </nav>
    <button id="mobile-menu-toggle" class="md:hidden flex items-center justify-center w-10 h-10 rounded hover:bg-gray-50 relative" aria-label="Toggle navigation menu" aria-expanded="false">
      <svg id="mobile-menu-icon" class="h-5 w-5 text-gray-600 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="mobile-close-icon" class="h-5 w-5 text-gray-600 absolute transition-transform hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
  <div id="mobile-menu" class="w-full bg-white border-t border-gray-100">
    <div class="px-4 py-3 space-y-2">
      <a :href="this.navHome || '/'" class="nav-link text-sm font-medium hover:opacity-70 transition-opacity block py-2">Home</a>
      <a :href="this.navAbout || '/about.html'" class="nav-link text-sm font-medium hover:opacity-70 transition-opacity block py-2">About</a>
      <a :href="this.navProjects || '/projects.html'" class="nav-link text-sm font-medium hover:opacity-70 transition-opacity block py-2">All Projects</a>
      <a :href="this.navContact || '/contact.html'" class="nav-link text-sm font-medium hover:opacity-70 transition-opacity block py-2">Contact</a>
      <a href="javascript:window.print()" class="header-pdf-link header-pdf-link--mobile" onclick="window.print();return false">
        <svg class="header-pdf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></polyline></svg>
        <span>Print / Save PDF</span>
      </a>
    </div>
  </div>
</header>
