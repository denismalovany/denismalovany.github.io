<script webc:setup>
const skills = this.skills || {};
const categories = Object.keys(skills);
</script>
<div class="grid gap-6 md:grid-cols-3">
  <div webc:for="cat of categories">
    <h3 class="text-xl font-serif mb-4" @text="cat"></h3>
    <ul class="text-gray-600">
      <li webc:for="skill of skills[cat]" @text="skill"></li>
    </ul>
  </div>
</div>
