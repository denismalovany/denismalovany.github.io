---
import { ViewTransitions } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteData } from '../data/site';
import { skillsData } from '../data/skills';
import { timelineData } from '../data/timeline';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
  currentPage?: string;
  suppressJsonLd?: boolean;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage,
  jsonLd,
  currentPage,
  suppressJsonLd = false,
} = Astro.props;

const defaultJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": siteData.name,
  "email": siteData.email,
  "url": Astro.url.origin,
  "sameAs": [siteData.linkedin],
  "jobTitle": "Product Designer & Mechanical Engineer",
  "description": siteData.tagline,
  "knowsAbout": Object.values(skillsData).flat(),
  "alumniOf": timelineData.map(e => ({
    "@type": "OrganizationRole",
    "roleName": e.subtitle || "",
    "startDate": e.period,
    "affiliation": { "@type": "Organization", "name": e.company }
  }))
};

const jsonLdString = suppressJsonLd ? null : JSON.stringify(jsonLd || defaultJsonLd, null, 4);
const finalOgImage = ogImage || new URL('/favicon.svg', Astro.url.origin).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <BaseHead
    title={title}
    description={description}
    ogTitle={ogTitle}
    ogDescription={ogDescription}
    ogImage={finalOgImage}
    jsonLd={jsonLdString}
  />
  <ViewTransitions />
</head>
<body class="antialiased">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[9999] focus:px-4 focus:py-2.5 focus:bg-accent-500 focus:text-white focus:rounded-lg focus:shadow-lg focus:text-sm focus:font-semibold focus:outline-none">
    Skip to content
  </a>
  <Header currentPage={currentPage} transition:persist />
  <main class="flex-1" id="main-content">
    <slot />
  </main>
  <Footer transition:persist />
  <script src="/scripts/interactive.js" type="module"></script>
</body>
</html>
