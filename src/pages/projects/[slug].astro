---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await project.render();
---
<Layout
  title={data.metaTitle}
  description={data.metaDescription}
  currentPage="project-detail"
  suppressJsonLd
>
  <PageHero title={data.heroTitle} subtitle={data.heroSubtitle}>
    {
      data.heroCta && (
        <div slot="after" class="mt-8">
          <a href={data.heroCta.href} target="_blank" rel="noopener noreferrer" class="btn-primary group link-external">
            {data.heroCta.label}
          </a>
        </div>
      )
    }
  </PageHero>

  <section class="section py-20 px-6 section-subtle">
    <div class="container mx-auto max-w-3xl">
      <div class="mb-10">
        <a href="/projects.html" class="text-sm font-semibold text-accent-600 link-arrow-back" data-astro-prefetch="hover">Back to All Projects</a>
      </div>

      <div class="glass-card p-8 mb-10">
        <Image src={data.image} alt={data.title} width={1200} height={800} class="w-full rounded-xl mb-8" loading="eager" />
        <p class="text-sm font-semibold text-accent-500 mb-3">Case Study</p>
        <h2 class="text-3xl md:text-4xl font-display font-extrabold mb-3 text-black">{data.title}</h2>
        <p class="text-gray-500 text-lg mb-6">{data.summary}</p>
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <span class="text-sm font-medium text-accent-600 bg-accent-50 px-3 py-1 rounded-full">{data.role}</span>
          {
            data.tags.map(tag => (
              <span class="text-sm text-gray-500 bg-gray-50 border border-gray-200 px-3 py-1 rounded-full">{tag}</span>
            ))
          }
        </div>
        {data.impact && (
          <div class="border-t border-gray-100 pt-4 mt-4">
            <p class="text-sm font-semibold text-gray-400 mb-1">Impact</p>
            <p class="text-gray-600">{data.impact}</p>
          </div>
        )}
      </div>

      <div class="prose prose-gray max-w-none prose-headings:font-display prose-headings:font-bold prose-headings:text-black prose-a:text-accent-600 prose-blockquote:border-accent-500">
        <Content />
      </div>

      {
        data.liveSite && (
          <div class="mt-12 text-center">
            <a href={data.liveSite} target="_blank" rel="noopener noreferrer" class="btn-primary group">
              View Live Project
              <span class="inline-block ml-2 transition-transform duration-fast group-hover:translate-x-1">&rarr;</span>
            </a>
          </div>
        )
      }
    </div>
  </section>
</Layout>
