---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const siteUrl = 'https://denismalovany.github.io';

const allProjects = (await getCollection('projects'))
  .filter(p => !p.data.draft)
  .sort((a, b) => a.data.weight - b.data.weight);
const currentIndex = allProjects.findIndex(p => p.slug === project.slug);
const prevProject = currentIndex > 0 ? allProjects[currentIndex - 1] : null;
const nextProject = currentIndex < allProjects.length - 1 ? allProjects[currentIndex + 1] : null;

const breadcrumbs = [
  { name: 'All Projects', url: `${siteUrl}/projects.html` },
  { name: data.title, url: `${siteUrl}/projects/${project.slug}.html` },
];
const breadcrumbJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    item: item.url,
  })),
});
const { Content } = await project.render();
---
<Layout
  title={data.metaTitle}
  description={data.metaDescription}
  currentPage="project-detail"
  suppressJsonLd
>
  <PageHero title={data.heroTitle} subtitle={data.heroSubtitle} eyebrow="Case Study">
    {
      data.heroCta && (
        <div slot="after" class="mt-8">
          <a href={data.heroCta.href} target="_blank" rel="noopener noreferrer" class="btn-primary group link-external">
            {data.heroCta.label}
          </a>
        </div>
      )
    }
  </PageHero>

  <section class="py-20 px-6 section-subtle">
    <div class="mx-auto max-w-6xl">
      <nav aria-label="Breadcrumb" class="mb-10">
         <ol class="flex items-center flex-wrap gap-x-1.5 text-sm">
           <li class="flex items-center">
             <a href="/projects.html" class="text-accent-600 hover:text-accent-500 transition-colors duration-fast" data-astro-prefetch="hover">All Projects</a>
             <span class="mx-1.5 text-gray-300 select-none" aria-hidden="true">/</span>
           </li>
          <li>
            <span class="text-gray-500" aria-current="page">{data.title}</span>
          </li>
        </ol>
      </nav>
      <script type="application/ld+json" set:html={breadcrumbJsonLd}></script>

      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="tag">{data.role}</span>
        {
          data.tags.map(tag => (
            <span class="tag tag--plain">{tag}</span>
          ))
        }
      </div>
      {data.impact && (
        <div class="mb-10 text-sm text-gray-500">
          <span class="font-semibold text-gray-400">Impact: </span>{data.impact}
        </div>
      )}

      <div class="prose prose-gray max-w-none prose-headings:font-display prose-headings:font-bold prose-headings:text-black prose-a:text-accent-600 prose-blockquote:border-accent-500">
        <Content />
      </div>

      {
        data.liveSite && (
          <div class="mt-12 text-center">
            <a href={data.liveSite} target="_blank" rel="noopener noreferrer" class="btn-primary group">
              View Live Project
              <span class="inline-block ml-2 transition-transform duration-fast group-hover:translate-x-1">&rarr;</span>
            </a>
          </div>
        )
      }

      <nav class="case-nav mt-16 pt-10 border-t border-gray-100" aria-label="Other cases">
        {
          prevProject ? (
            <a href={`/projects/${prevProject.slug}.html`} class="case-nav__item" data-astro-prefetch="hover">
              <div class="case-nav__label">Previous case</div>
              <div class="case-nav__title">{prevProject.data.title}</div>
              <div class="case-nav__arrow">Read</div>
            </a>
          ) : (
            <a href="/projects.html" class="case-nav__item" data-astro-prefetch="hover">
              <div class="case-nav__label">All projects</div>
              <div class="case-nav__title">Back to the list</div>
              <div class="case-nav__arrow">All cases</div>
            </a>
          )
        }
        {
          nextProject ? (
            <a href={`/projects/${nextProject.slug}.html`} class="case-nav__item case-nav__item--next" data-astro-prefetch="hover">
              <div class="case-nav__label">Next case</div>
              <div class="case-nav__title">{nextProject.data.title}</div>
              <div class="case-nav__arrow">Read</div>
            </a>
          ) : (
            <a href="/projects.html" class="case-nav__item case-nav__item--next" data-astro-prefetch="hover">
              <div class="case-nav__label">All projects</div>
              <div class="case-nav__title">Back to the list</div>
              <div class="case-nav__arrow">All cases</div>
            </a>
          )
        }
      </nav>
    </div>
  </section>
</Layout>
