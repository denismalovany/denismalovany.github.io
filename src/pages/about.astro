---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { siteData } from '../data/site';
import Timeline from '../components/Timeline.astro';
import SkillsGrid from '../components/SkillsGrid.astro';
import portrait from '../images/portrait.jpeg';

const page = siteData.pages.about;
---
<Layout
  title={page.title}
  description={page.description}
  currentPage="about"
>
  <PageHero title={siteData.name} subtitle={siteData.aboutTagline} />

  <section id="about" class="section py-24 px-6 section-subtle">
    <div class="container mx-auto max-w-5xl reveal-container">
      <h2 class="text-2xl md:text-3xl section-title section-title--mb-8 reveal-stagger">About Me</h2>
      
      <div class="grid md:grid-cols-[1fr_320px] gap-10 md:gap-14 items-start">
        <div class="prose prose-gray max-w-none text-gray-600 leading-relaxed space-y-5">
          <p class="reveal-stagger">
            I'm Denys Malovanyi, a product designer and frontend developer with over 9 years of experience spanning UI/UX design, frontend development, and mechanical engineering. I currently work as a Mechanical Engineer and Product Designer at VOL Volunteer Optical Laboratory, creating user-centered digital and physical products.
          </p>
          <p class="reveal-stagger">
            Beyond traditional design and development skills, I experiment with AI agents and local LLM deployment to enhance my design research, prototyping, and workflow automation — bringing emerging technology principles into practical design solutions.
          </p>
          <p class="reveal-stagger">
            My career began in frontend development at BITECC GmbH and InvestGo24 in 2015, where I built responsive interfaces and landing pages. I then grew into full-stack UI roles at Codemotion Ninjas and Cygnati Group, working on diverse projects from e-commerce platforms to medical information portals and mobile applications.
          </p>
          <p class="reveal-stagger">
            At HebronSoft, I transitioned fully into UI/UX design, leading design projects and mentoring junior designers — growing from a frontend developer into a product designer who thinks beyond the interface.
          </p>
          <p class="text-gray-500 text-sm reveal-stagger">
            I love traveling, and when I'm not designing I'm likely snowboarding or rock climbing — activities that teach persistence, problem-solving, and the value of a clear plan before you commit.
          </p>
        </div>

        <div class="reveal-stagger md:sticky md:top-28">
          <div class="relative">
            <div class="absolute -inset-2 rounded-2xl bg-gradient-to-br from-accent-300/40 to-accent-600/20 blur-sm"></div>
            <Image
              src={portrait}
              alt="Denys Malovanyi"
              class="relative w-full max-w-[320px] mx-auto rounded-xl shadow-accent-lg object-cover"
              width={320}
              height={480}
              loading="lazy"
            />
          </div>
        </div>
      </div>

      <hr class="divider reveal-stagger mt-12" />
      <p class="text-gray-600 leading-relaxed reveal-stagger">
        My approach combines rigorous research with thoughtful aesthetics. I believe great design emerges from understanding user needs deeply, translating insights into intuitive interfaces, and refining every detail through iterative prototyping and testing.
      </p>
      <p class="text-gray-500 leading-relaxed mt-4 reveal-stagger">
        I'm proficient in HTML, CSS, JavaScript, and modern design tools. I thrive in cross-functional teams and enjoy bridging the gap between design and development to deliver polished, accessible, and performant products.
      </p>

      <div class="text-center mt-12 reveal-stagger">
        <a href="/CV/Denys_Malovanyi_CV.pdf" target="_blank" class="btn-primary">
          <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          Download Resume
        </a>
      </div>

      <div class="text-center mt-6 reveal-stagger">
        <a href="/contact" class="btn-outline">
          Get in Touch
          <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>

      <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 mt-10 text-sm text-gray-400 reveal-stagger">
        <span>🇺🇦 Ukrainian — Native</span>
        <span>🇬🇧 English — Intermediate</span>
        <span>🇵🇱 Polish — Below Intermediate</span>
      </div>

      <div class="mt-12 reveal-stagger">
        <h3 class="text-center text-sm font-semibold text-gray-400 uppercase tracking-wider mb-4">Licenses &amp; Certifications</h3>
        <div class="flex flex-wrap justify-center gap-4">
          <div class="glass-card px-5 py-3 text-center min-w-[200px]">
            <p class="text-sm font-semibold text-gray-700">UX Research</p>
            <p class="text-xs text-gray-400 mt-0.5">Projector Institute · Aug 2023</p>
          </div>
          <div class="glass-card px-5 py-3 text-center min-w-[200px]">
            <p class="text-sm font-semibold text-gray-700">Product Design</p>
            <p class="text-xs text-gray-400 mt-0.5">Projector Institute · Mar 2021</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="skills" class="section py-24 px-6">
    <div class="container mx-auto max-w-3xl reveal-container">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl section-title section-title--mb-8 mx-auto text-center reveal-stagger">Skills &amp; Expertise</h2>
      </div>
      <div class="reveal-stagger">
        <SkillsGrid />
      </div>
    </div>
  </section>

  <section id="timeline" class="section py-24 px-6 section-subtle">
    <div class="container mx-auto max-w-3xl reveal-container">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl section-title section-title--mb-8 mx-auto text-center reveal-stagger">Professional Timeline</h2>
        <p class="text-gray-500 mb-10 max-w-2xl mx-auto text-center reveal-stagger">
          A chronological overview of my career progression from frontend development to product design and mechanical engineering.
        </p>
      </div>
      <div class="reveal-stagger">
        <Timeline collapsed={false} />
      </div>
    </div>
  </section>
</Layout>
