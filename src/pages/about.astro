---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { siteData } from '../data/site';
import Timeline from '../components/Timeline.astro';
import SkillsGrid from '../components/SkillsGrid.astro';
import portrait from '../images/portrait.jpeg';

const page = siteData.pages.about;
---
<Layout
  title={page.title}
  description={page.description}
  currentPage="about"
>
  <PageHero title={siteData.name} subtitle={siteData.aboutTagline} eyebrow="About me" />

  <section id="about" class="py-24 px-6 section-subtle">
    <div class="mx-auto max-w-6xl reveal-container">
      <h2 class="text-2xl md:text-3xl section-title section-title--mb-8 reveal-stagger">About Me</h2>

      <div class="md:hidden reveal-stagger mb-8">
        <div class="relative group">
          <div class="absolute -inset-2 rounded-2xl bg-accent-500/15 blur-lg opacity-0 group-hover:opacity-100 transition-opacity duration-normal"></div>
          <div class="relative rounded-2xl overflow-hidden shadow-accent border border-gray-100">
            <Image
              src={portrait}
              alt="Denys Malovanyi"
              class="w-full object-cover"
              width={320}
              height={480}
              loading="lazy"
            />
          </div>
        </div>
      </div>

      <div class="grid md:grid-cols-[1fr_320px] gap-10 md:gap-14">
        <div class="flex flex-col h-full">
          <div class="flex items-center gap-2 text-sm text-gray-500 mb-5 reveal-stagger">
            <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
            </svg>
            <span>Kyiv, Ukraine</span>
            <span class="tag tag--plain">Remote / On-site</span>
          </div>

          <div class="prose prose-gray max-w-none text-gray-600 leading-relaxed space-y-5">
            <p class="reveal-stagger">
              I'm Denys Malovanyi, a product designer and frontend developer with over 9 years of experience across UI/UX design, frontend development, and mechanical engineering. Currently, I work as a {siteData.currentRole}, creating user-centered digital and physical products.
            </p>
            <p class="reveal-stagger">
              Beyond traditional design and development, I experiment with AI agents and local LLM deployment to enhance my design research, prototyping, and workflow automation — bringing emerging technology principles into practical design solutions. My approach bridges the gap between design thinking and technical execution, with a focus on iterative prototyping and thoughtful aesthetics.
            </p>
            <p class="reveal-stagger">
              When I'm not designing, I'm likely snowboarding or rock climbing.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row sm:space-x-4 mt-auto pt-8 reveal-stagger">
            <a href={siteData.resumePdf} target="_blank" class="btn-primary group">
              <span>Download Resume</span>
              <span class="inline-block ml-2 transition-transform duration-fast group-hover:translate-x-1">&rarr;</span>
            </a>
            <a href="/contact.html" class="btn-outline mt-3 sm:mt-0" data-astro-prefetch="hover">
              Get in Touch
            </a>
          </div>
        </div>

        <div class="reveal-stagger md:sticky md:top-28 space-y-6">
          <div class="hidden md:block relative group">
            <div class="absolute -inset-2 rounded-2xl bg-accent-500/15 blur-lg opacity-0 group-hover:opacity-100 transition-opacity duration-normal"></div>
            <div class="relative rounded-2xl overflow-hidden shadow-accent border border-gray-100">
              <Image
                src={portrait}
                alt="Denys Malovanyi"
                class="w-full md:max-w-[320px] mx-auto object-cover"
                width={320}
                height={480}
                loading="lazy"
              />
            </div>
          </div>

          <div class="space-y-4 pt-2">
            <div class="text-sm text-gray-500 space-y-1">
              <h4 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Languages</h4>
              <p>Ukrainian — Native</p>
              <p>English — Intermediate</p>
              <p>Polish — Below Intermediate</p>
            </div>

            <div class="text-sm text-gray-500 space-y-1">
              <h4 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Licenses</h4>
              <p>UX Research — Projector Institute &middot; 2023</p>
              <p>Product Design — Projector Institute &middot; 2021</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="skills" class="py-24 px-6 section-subtle">
    <div class="mx-auto max-w-6xl reveal-container">
      <h2 class="text-2xl md:text-3xl section-title section-title--mb-8 reveal-stagger">Skills &amp; Expertise</h2>
      <div class="reveal-stagger">
        <SkillsGrid />
      </div>
    </div>
  </section>

  <section id="timeline" class="py-24 px-6 section-subtle">
    <div class="mx-auto max-w-6xl reveal-container">
      <h2 class="text-2xl md:text-3xl section-title section-title--mb-8 reveal-stagger">Professional Timeline</h2>
      <div class="reveal-stagger">
        <Timeline collapsed={false} />
      </div>
    </div>
  </section>
</Layout>
