---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { siteData } from '../data/site';
import { timelineData } from '../data/timeline';
import { skillsData } from '../data/skills';
import Timeline from '../components/Timeline.astro';
import ProjectCard from '../components/ProjectCard.astro';

const page = siteData.pages.index;
const projects = await getCollection('projects');
const featuredProjects = projects.sort((a, b) => a.data.weight - b.data.weight).slice(0, 2);
---
<Layout
  title={page.title}
  description={page.description}
  currentPage="home"
>
  <PageHero title={siteData.name} subtitle={siteData.tagline}>
    <div slot="after" class="mt-8 flex flex-col sm:flex-row sm:space-x-4 sm:justify-center relative z-[1]">
      <a href="/projects.html" class="px-6 py-3 bg-black text-white rounded-lg font-medium sm:w-auto w-full sm:w-1/2 text-center hover:-translate-y-1 hover:scale-[1.01] hover:shadow-xl active:-translate-y-px active:scale-[1.005] active:shadow-md transition duration-normal">Explore My Work</a>
      <a href="/contact.html" class="mt-4 sm:mt-0 px-6 py-3 border border-gray-300 text-gray-700 rounded-lg font-medium sm:w-auto w-full sm:w-1/2 text-center hover:-translate-y-1 hover:scale-[1.01] hover:shadow-xl hover:border-gray-400 hover:bg-gray-50 active:-translate-y-px active:scale-[1.005] active:shadow-sm transition duration-normal">Get in Touch</a>
    </div>
  </PageHero>

  <!-- About Section (Short Version) -->
  <section id="about-preview" class="section py-20 px-6 bg-gray-50">
    <div class="container mx-auto max-w-3xl">
      <h2 class="text-2xl font-serif section-title-mb-6">About Me</h2>
      <p class="text-gray-700 leading-relaxed mb-6 max-w-2xl mx-auto">
        I'm Denys Malovanyi, a UX/UI and product designer currently working as an engineer at Miltec. I specialize in creating user-centered digital experiences through interaction design, visual design, and prototyping.
      </p>
      <p class="text-gray-600 max-w-2xl mx-auto">
        My approach combines rigorous research with thoughtful aesthetics to craft solutions that are both functional and delightful.
      </p>
      <p class="text-gray-600 max-w-2xl mx-auto mt-4">
        I also experiment with AI agents and local LLM deployment to enhance my design research, prototyping, and workflow automation.
      </p>

      <!-- Skills Tags -->
      <div class="flex flex-wrap justify-center gap-3 mt-8">
        {Object.values(skillsData).flat().map(skill => (
          <span class="px-4 py-2 bg-white border border-gray-200 text-gray-700 text-sm font-medium rounded-full">{skill}</span>
        ))}
      </div>

      <a href="/about.html" class="mt-8 inline-block text-sm font-medium text-link link-arrow">
        Learn More About Me
      </a>
    </div>
  </section>

  <!-- Work Timeline Section -->
  <section id="timeline" class="section py-20 px-6">
    <div class="container mx-auto max-w-3xl">
      <h2 class="text-2xl font-serif section-title-mb-8 text-center">Professional Timeline</h2>
      <p class="text-gray-600 mb-8 max-w-2xl mx-auto">
        A chronological overview of my career progression from frontend development to product design.
      </p>

      <Timeline collapsed={true} />
    </div>
  </section>

  <!-- Projects Section (Featured) -->
  <section id="projects" class="section py-20 px-6 bg-gray-50">
    <div class="container mx-auto max-w-3xl">
      <h2 class="text-2xl font-serif section-title-mb-8">Featured Projects</h2>
      <p class="text-gray-600 mb-6 max-w-2xl mx-auto">
        A selection of recent work demonstrating my product design approach and problem-solving skills.
      </p>
      <div id="projects-grid" class="grid gap-8 md:grid-cols-2">
        {featuredProjects.map(project => (
          <ProjectCard project={project} />
        ))}
      </div>
      <div class="mt-10 text-center">
         <a href="/projects.html" class="inline-block px-6 py-3 bg-black text-white rounded-lg font-medium hover:-translate-y-1 hover:scale-[1.01] hover:shadow-xl active:-translate-y-px active:scale-[1.005] active:shadow-md transition duration-normal link-arrow">
          See All Projects
        </a>
      </div>
    </div>
  </section>
</Layout>
