---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { siteData } from '../data/site';
import { skillsData } from '../data/skills';
import Timeline from '../components/Timeline.astro';
import ProjectCard from '../components/ProjectCard.astro';
import FontPreview from '../components/FontPreview.astro';
import AccentPreview from '../components/AccentPreview.astro';

const page = siteData.pages.index;
const projects = await getCollection('projects');
const featuredProjects = projects.sort((a, b) => a.data.weight - b.data.weight).slice(0, 2);
---
<Layout
  title={page.title}
  description={page.description}
  currentPage="home"
>
  <PageHero title={siteData.name} subtitle={siteData.tagline} gridOverlay={true}>
    <div slot="after" class="mt-10 flex flex-col sm:flex-row sm:space-x-4 sm:justify-center relative z-[1] reveal">
      <a href="/projects.html" class="btn-primary group" data-astro-prefetch="hover" data-magnetic>
        <span>Explore My Work</span>
        <span class="inline-block ml-2 transition-transform duration-fast group-hover:translate-x-1">&rarr;</span>
      </a>
      <a href="/contact.html" class="btn-outline mt-3 sm:mt-0" data-astro-prefetch="hover" data-magnetic>
        Get in Touch
      </a>
    </div>
  </PageHero>

  <section id="about-preview" class="section py-24 px-6 section-subtle">
    <div class="container mx-auto max-w-3xl reveal-container">
      <h2 class="text-2xl md:text-3xl section-title-mb-6 reveal-stagger">About Me</h2>
      <div class="prose prose-gray max-w-none">
        <p class="text-gray-600 leading-relaxed mb-5 text-lg reveal-stagger">
          I'm Denys Malovanyi, a UX/UI and product designer currently working as an engineer at Miltec. I specialize in creating user-centered digital experiences through interaction design, visual design, and prototyping.
        </p>
        <p class="text-gray-500 leading-relaxed mb-5 reveal-stagger">
          My approach combines rigorous research with thoughtful aesthetics to craft solutions that are both functional and delightful.
        </p>
        <p class="text-gray-500 leading-relaxed reveal-stagger">
          I also experiment with AI agents and local LLM deployment to enhance my design research, prototyping, and workflow automation.
        </p>
      </div>

      <div class="flex flex-wrap gap-2.5 mt-8 reveal-stagger">
        {Object.values(skillsData).flat().map(skill => (
          <span class="px-4 py-2 text-sm font-medium text-accent-700 bg-accent-50 border border-accent-100 rounded-full">{skill}</span>
        ))}
      </div>

      <a href="/about.html" class="mt-8 inline-block text-sm font-semibold text-accent-600 link-arrow reveal-stagger" data-astro-prefetch="hover">
        Learn More About Me
      </a>
    </div>
  </section>

  <section id="timeline" class="section py-24 px-6">
    <div class="container mx-auto max-w-3xl reveal-container">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl section-title-mb-8 mx-auto text-center reveal-stagger">Professional Timeline</h2>
        <p class="text-gray-500 mb-10 max-w-2xl mx-auto text-center reveal-stagger">
          A chronological overview of my career progression from frontend development to product design.
        </p>
      </div>
      <div class="reveal-stagger">
        <Timeline collapsed={true} />
      </div>
    </div>
  </section>

  <section id="projects" class="section py-24 px-6 section-subtle">
    <div class="container mx-auto max-w-3xl reveal-container">
      <h2 class="text-2xl md:text-3xl section-title-mb-8 reveal-stagger">Featured Projects</h2>
      <p class="text-gray-500 mb-10 max-w-2xl reveal-stagger">
        A selection of recent work demonstrating my product design approach and problem-solving skills.
      </p>
      <div id="projects-grid" class="grid gap-8 md:grid-cols-2">
        {featuredProjects.map((project, i) => (
          <div class="reveal-stagger">
            <ProjectCard project={project} />
          </div>
        ))}
      </div>
      <div class="mt-10 text-center reveal-stagger">
         <a href="/projects.html" class="btn-primary group" data-astro-prefetch="hover" data-magnetic>
          See All Projects
          <span class="inline-block ml-2 transition-transform duration-fast group-hover:translate-x-1">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <FontPreview />

  <AccentPreview />
</Layout>
