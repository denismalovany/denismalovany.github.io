---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { siteData } from '../data/site';
import ProjectCard from '../components/ProjectCard.astro';

const page = siteData.pages.projects;
const projects = await getCollection('projects');
const sortedProjects = projects.filter(p => !p.data.draft).sort((a, b) => a.data.weight - b.data.weight);

---
<Layout
  title={page.title}
  description={page.description}
  currentPage="projects"
  suppressJsonLd
>
  <PageHero title="All Projects" subtitle="Complete portfolio of work" />

  <section id="projects" class="section py-24 px-6 section-subtle">
    <div class="container mx-auto max-w-3xl">
      <h2 class="text-2xl md:text-3xl section-title section-title--mb-8">Project Portfolio</h2>
      <p class="text-gray-600 mb-6 max-w-2xl">
        A comprehensive collection of product design projects showcasing my approach to solving user problems through interaction design, visual design, and prototyping.
      </p>

      <div id="projects-grid" class="grid gap-8 md:grid-cols-2">
        {sortedProjects.map(project => (
          <div class="project-card-wrapper">
            <ProjectCard project={project} />
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

