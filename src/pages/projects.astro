---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { siteData } from '../data/site';

const page = siteData.pages.projects;
const projects = await getCollection('projects');
const sortedProjects = projects.filter(p => !p.data.draft).sort((a, b) => a.data.weight - b.data.weight);

const totalProjects = sortedProjects.length;
const allTags = [...new Set(sortedProjects.flatMap(p => p.data.tags))].sort();
const uniqueDisciplines = allTags.length;

const featuredProject = sortedProjects[0];
const gridProjects = sortedProjects.slice(1);

const statsInsertAt = Math.floor(gridProjects.length / 2);

---

<Layout
  title={page.title}
  description={page.description}
  currentPage="projects"
  suppressJsonLd
>
  <PageHero
    eyebrow="Portfolio"
    title="Selected Work"
    subtitle={`${totalProjects} projects spanning UX research, UI design, design systems, and front-end implementation — each included for the problem it solved, not just the visual output.`}
  >
    <div slot="after" class="flex flex-wrap items-center justify-center gap-6 mt-7" data-od-id="hero-stats">
      <div class="text-center">
        <div class="text-2xl md:text-3xl font-display font-bold text-black">{totalProjects}</div>
        <div class="text-xs text-gray-400 uppercase tracking-wider mt-0.5">Projects</div>
      </div>
      <div class="w-px h-10 bg-gray-200 hidden sm:block" aria-hidden="true"></div>
      <div class="text-center">
        <div class="text-2xl md:text-3xl font-display font-bold text-black">{uniqueDisciplines}</div>
        <div class="text-xs text-gray-400 uppercase tracking-wider mt-0.5">Disciplines</div>
      </div>
    </div>
  </PageHero>

  <section class="px-6 pb-24" data-od-id="projects-section">
    <div class="mx-auto max-w-7xl">

      <div class="fp-wrap" data-od-id="featured-wrap">
        <FeaturedProject project={featuredProject} />
      </div>

      <div class="bento-grid" id="bento-grid" data-od-id="projects-grid">
        {gridProjects.map((project, i) => (
          <>
            {i === statsInsertAt && (
              <ProjectCard variant="stats" statsTotal={totalProjects} />
            )}
            <ProjectCard
              project={project}
              variant={project.data.bentoLayout ?? 'default'}
              accent={project.data.bentoAccent ?? false}
            />
          </>
        ))}

      </div>

    </div>
  </section>
</Layout>

