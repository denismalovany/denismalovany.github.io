---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout
  title="Page Not Found - Denys Malovanyi"
  description="The page you're looking for doesn't exist."
  suppressJsonLd
>
  <PageHero title="404" subtitle="Page not found" />
  <section class="py-24 px-6 text-center">
    <div class="container mx-auto max-w-lg">
      <div class="mb-8">
        <svg class="w-20 h-20 mx-auto text-accent-400 mb-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
        </svg>
        <p class="text-gray-500 text-lg">The page you're looking for doesn't exist or has been moved.</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/index.html" class="btn-primary group" data-astro-prefetch="hover">
          <span>Back to Home</span>
          <span class="btn-arrow">&rarr;</span>
        </a>
        <a href="/projects.html" class="btn-outline" data-astro-prefetch="hover">
          Browse Projects
        </a>
      </div>
    </div>
  </section>
</Layout>
