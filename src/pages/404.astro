---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout
  title="Page Not Found - Denys Malovanyi"
  description="The page you're looking for doesn't exist."
  suppressJsonLd
>
  <PageHero title="404" subtitle="Page not found" />
  <section class="py-20 px-6 text-center">
    <p class="text-gray-600 mb-8">The page you're looking for doesn't exist or has been moved.</p>
    <a href="/index.html" class="inline-block px-6 py-3 bg-black text-white rounded-lg font-medium hover:-translate-y-1 hover:scale-[1.01] hover:shadow-xl transition duration-normal">
      Back to Home
    </a>
  </section>
</Layout>
