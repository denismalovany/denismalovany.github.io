---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project?: CollectionEntry<'projects'>;
  variant?: 'default' | 'span-2-tall' | 'span-2-wide' | 'stats';
  accent?: boolean;
  statsTotal?: number;
  statsText?: string;
}

const { project, variant = 'default', accent = false, statsTotal, statsText } = Astro.props;

const isStats = variant === 'stats';

let variantClass = '';
if (variant === 'span-2-tall') variantClass = 'bc-span-2 bc-tall';
if (variant === 'span-2-wide') variantClass = 'bc-span-2 bc-wide';
if (accent) variantClass += ' bc-accent';

const totalDisplay = statsTotal ?? 6;
const labelDisplay = statsText ?? 'Projects spanning UX research, design systems, physical prototyping, and cross-cultural UI — each with a clear problem statement and measurable outcome.';
---

{isStats ? (
  <div class="bento-card bc-stats" data-od-id="bento-stats">
    <div class="bc-stats-body">
      <div class="bc-stats-number">{totalDisplay}</div>
      <p class="bc-stats-text">{labelDisplay}</p>
    </div>
  </div>
) : project ? (
  <>
    {(() => {
      const { data } = project;
      return (
        <div class={`bento-card ${variantClass}`} data-tags={JSON.stringify(data.tags)} data-od-id={`bento-${project.slug}`}>
          <a href={`projects/${project.slug}.html`} class="bc-link" data-astro-prefetch="hover">
            <div class="bc-image">
              <Image
                src={data.image}
                alt={data.title}
                width={800}
                height={variant === 'span-2-tall' ? 1067 : variant === 'span-2-wide' ? 450 : 533}
                sizes="(max-width: 500px) 100vw, (max-width: 768px) 50vw, (max-width: 1100px) 33vw, 25vw"
                class="bc-img"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="bc-body">
              {data.tags && data.tags.length > 0 && (
                <div class="bc-tags">
                  {data.tags.map(tag => <span class="bc-tag">{tag}</span>)}
                </div>
              )}
              <h3 class="bc-title">{data.title}</h3>
              <p class="bc-summary">{data.summary}</p>
              <span class="bc-role">{data.role}</span>
            </div>
          </a>
        </div>
      );
    })()}
  </>
) : null}
