---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  root?: string;
}

const { project, root = '' } = Astro.props;
const summary = project.summary || project.description;
---
<a href={`${root}projects/project-${project.id}.html`} class="block h-full">
  <div class="card-b h-full">
    <img src={project.image} alt={project.title} class="card-b-img" loading="lazy" />
    <div class="card-b-body">
      {
        project.tags && project.tags.length > 0 && (
          <div class="card-b-tags">
            {project.tags.map(tag => (
              <span class="card-b-tag">{tag}</span>
            ))}
          </div>
        )
      }
      <h3 class="card-b-title">{project.title}</h3>
      <p class="card-b-summary">{summary}</p>
      {project.role && <p class="card-b-meta">{project.role}</p>}
    </div>
  </div>
</a>
