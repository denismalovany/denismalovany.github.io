---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  root?: string;
}

const { project, root = '' } = Astro.props;
const summary = project.summary || project.description;
---
<a href={`${root}projects/project-${project.id}.html`} class="block h-full">
  <div class="flex flex-col border border-gray-100 rounded-lg bg-white transition duration-normal hover:-translate-y-1 hover:shadow-lg hover:border-gray-200 overflow-hidden h-full group">
    <img src={project.image} alt={project.title} class="w-full aspect-[3/2] object-cover block transition duration-normal group-hover:brightness-95" loading="lazy" />
    <div class="px-6 pt-5 pb-6 flex flex-col grow">
      {
        project.tags && project.tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5 mb-3">
            {project.tags.map(tag => (
              <span class="inline-flex items-center py-1 px-2.5 text-2xs font-medium tracking-[0.02em] uppercase text-gray-600 bg-white border border-gray-200 rounded-full">{tag}</span>
            ))}
          </div>
        )
      }
      <h3 class="font-serif text-lg md:text-xl font-bold uppercase tracking-wider text-black leading-tight mb-3 md:mb-5">{project.title}</h3>
      <p class="text-base-plus text-gray-600 leading-relaxed line-clamp-3 overflow-hidden mb-3 group-hover:text-gray-700">{summary}</p>
      {project.role && <p class="text-sm font-medium uppercase tracking-[0.075em] text-gray-400 mt-auto pt-3 border-t border-gray-100 group-hover:text-gray-500">{project.role}</p>}
    </div>
  </div>
</a>
