---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;

const coverFallbackVariants = [
  'cover-fallback--checkout',
  'cover-fallback--dashboard',
  'cover-fallback--research',
  'cover-fallback--migration',
  'cover-fallback--mobile',
  'cover-fallback--cart',
];
const fallbackClass = coverFallbackVariants[project.slug.length % coverFallbackVariants.length];
---
<a href={`projects/${project.slug}.html`} class="block h-full group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-offset-2 rounded-2xl" data-astro-prefetch="hover" data-od-id={`project-card-${project.slug}`}>
  <div class="flex flex-col glass-card rounded-2xl transition-all duration-normal overflow-hidden h-full hover:shadow-accent-lg hover:-translate-y-1">
    <div class="overflow-hidden">
      <div class="relative w-full aspect-[3/2]">
        <Image
          src={data.image}
          alt={data.title}
          width={800}
          height={533}
          sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 400px"
          class="w-full aspect-[3/2] object-cover block transition duration-slow group-hover:scale-[1.03]"
          loading="lazy"
          decoding="async"
        />
        <div class={`cover-fallback ${fallbackClass} absolute inset-0 transition duration-slow group-hover:scale-[1.03] -z-[1]`} aria-hidden="true"></div>
      </div>
    </div>
    <div class="p-6 sm:p-8 flex flex-col grow">
      {
        data.tags && data.tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5 mb-3">
            {data.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )
      }
      <h3 class="font-display text-lg md:text-xl font-bold text-black leading-tight mb-3 md:mb-5 group-hover:text-accent-600 transition-colors duration-fast" data-od-id={`project-title-${project.slug}`}>{data.title}</h3>
      <p class="text-sm-plus text-gray-600 leading-relaxed line-clamp-3 overflow-hidden mb-3" data-od-id={`project-summary-${project.slug}`}>{data.summary}</p>
      {data.role && <p class="text-sm font-semibold text-gray-400 mt-auto pt-4 border-t border-gray-100" data-od-id={`project-role-${project.slug}`}>{data.role}</p>}
    </div>
  </div>
</a>
