---
import { siteData } from '../data/site';

const socialLinks = [
  { label: 'LinkedIn', href: siteData.linkedin, external: true },
  { label: 'Email', href: `mailto:${siteData.email}`, external: false },
  { label: 'Behance', href: siteData.behance, external: true },
  { label: 'Dribbble', href: siteData.dribbble, external: true },
];
---
<footer class="border-t border-gray-100 bg-gray-50 py-6 px-6">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-4">
    <div class="flex items-center gap-6 flex-wrap min-w-0">
      <p class="text-xs text-gray-400 whitespace-nowrap hidden sm:block">&copy; {siteData.copyrightYear} {siteData.name}</p>
    </div>
    <div class="shrink-0 self-start sm:self-auto">
      <div class="flex items-center gap-5">
        {
          socialLinks.map(link => (
            <a
              href={link.href}
              class="text-sm-plus font-medium text-gray-600 no-underline hover:text-black transition-colors duration-fast"
              {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
