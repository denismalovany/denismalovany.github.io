---
import { siteData } from '../data/site';

const socialLinks = [
  { label: 'LinkedIn', href: siteData.linkedin, external: true },
  { label: 'Email', href: `mailto:${siteData.email}`, external: false },
  { label: 'Behance', href: siteData.behance, external: true },
  { label: 'Dribbble', href: siteData.dribbble, external: true },
];
---
<footer class="border-t border-gray-100/80 py-8 px-6 mt-auto">
  <div class="container mx-auto max-w-6xl">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="flex flex-col gap-1">
        <p class="text-xs text-gray-400">&copy; {siteData.copyrightYear} {siteData.name}</p>
        <p class="text-xs text-gray-300">Product Designer &amp; Engineer</p>
      </div>
      <div class="flex items-center gap-6">
        {
          socialLinks.map(link => (
            <a
              href={link.href}
              class="text-sm font-medium text-gray-500 no-underline link-underline link-external"
              {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
