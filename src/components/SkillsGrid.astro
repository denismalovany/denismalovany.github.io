---
import { skillsData } from '../data/skills';
---
<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
  {
    Object.entries(skillsData).map(([category, skills]) => (
      <div>
        <h3 class="font-display font-bold text-black text-sm uppercase tracking-wider mb-4">
          {category}
        </h3>
        <ul class="space-y-2.5">
          {skills.map(skill => (
            <li class="flex items-center gap-2.5 text-gray-600 text-sm-plus">
              <span class="w-1.5 h-1.5 rounded-full bg-accent-400 shrink-0"></span>
              {skill}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
