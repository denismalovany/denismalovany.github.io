---
import type { TimelineEntry } from '../data/timeline';

interface Props {
  entry: TimelineEntry;
  isLast: boolean;
}

const { entry, isLast } = Astro.props;
const borderClass = isLast
  ? 'relative pl-8 border-l-2 timeline-line pb-0'
  : 'relative pl-8 pb-12 border-l-2 timeline-line';
const dotClass = entry.dotColor === 'gray'
  ? 'timeline-dot timeline-dot--gray'
  : 'timeline-dot timeline-dot--accent';
---
<div class={`timeline-entry ${borderClass}`}>
  <div class={dotClass}></div>
  <p class="text-xs font-semibold uppercase tracking-[0.1em] text-gray-400 mb-1.5">{entry.period}</p>
  <h3 class="text-lg font-display font-bold mb-0.5 text-black">{entry.company}</h3>
  {entry.subtitle && (
    <p class="text-sm font-semibold text-accent-500 uppercase tracking-wide mb-3">{entry.subtitle}</p>
  )}
  {
    entry.details && entry.details.length > 0 && (
      <div class="space-y-3">
        {entry.details.map(detail => (
          <div>
            {detail.role && (
              <p class="text-gray-700 font-semibold mb-0.5">{detail.role}</p>
            )}
            {detail.period && (
              <p class="text-xs font-semibold uppercase tracking-[0.1em] text-gray-400 mb-1">{detail.period}</p>
            )}
            <p class="text-gray-500 leading-relaxed text-sm-plus">{detail.description}</p>
          </div>
        ))}
      </div>
    )
  }
</div>
