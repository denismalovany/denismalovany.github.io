---
import type { TimelineEntry } from '../data/timeline';

interface Props {
  entry: TimelineEntry;
  isLast: boolean;
}

const { entry, isLast } = Astro.props;
const borderClass = isLast
  ? 'relative pl-8 border-l-2 border-gray-200'
  : 'relative pl-8 pb-12 border-l-2 border-gray-200';
const dotClass = entry.dotColor === 'gray'
  ? 'timeline-dot timeline-dot--gray'
  : 'timeline-dot';
---
<div class={borderClass}>
  <div class={dotClass}></div>
  <p class="caption mb-1">{entry.period}</p>
  <h3 class="text-lg font-serif font-bold mb-1">{entry.company}</h3>
  {entry.subtitle && (
    <p class="text-sm font-medium text-gray-500 uppercase tracking-wide mb-3">{entry.subtitle}</p>
  )}
  {
    entry.details && entry.details.length > 0 && (
      <>
        {entry.details.map(detail => (
          <div class="space-y-3">
            <div>
              {detail.role && (
                <p class="text-gray-700 font-medium mb-1">{detail.role}</p>
              )}
              {detail.period && (
                <p class="caption mb-0">{detail.period}</p>
              )}
              <p class="text-gray-600 leading-relaxed">{detail.description}</p>
            </div>
          </div>
        ))}
      </>
    )
  }
</div>
