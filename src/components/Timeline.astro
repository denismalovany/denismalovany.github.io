---
import { timelineData } from '../data/timeline';
import TimelineEntry from './TimelineEntry.astro';

interface Props {
  collapsed?: boolean;
}

const { collapsed = false } = Astro.props;

const visible = timelineData.filter(e => !e.collapsed);
const hidden = timelineData.filter(e => e.collapsed);
---

<style is:global>
  .timeline-collapsed {
    max-height: 2000px;
    opacity: 1;
    overflow: hidden;
    transition: max-height 500ms ease-out, opacity 500ms ease-out;
  }
  .timeline-collapsed.collapsed {
    max-height: 0;
    opacity: 0;
  }
  .timeline-dot {
    position: absolute;
    left: -9px;
    top: 0.25rem;
    width: 1rem;
    height: 1rem;
    border-radius: 9999px;
    background: var(--color-black);
  }
  .timeline-dot--accent {
    background: var(--color-accent-gradient);
    transition: filter var(--transition-fast);
  }
  .timeline-entry:hover .timeline-dot--accent {
    filter: brightness(1.15);
  }
  .timeline-dot--gray {
    background: var(--color-gray-300);
  }
  .timeline-line {
    border-color: var(--color-gray-200);
  }
</style>
{
  collapsed && hidden.length > 0 ? (
    <>
      <div id="timeline-container" class="space-y-0">
        {visible.map((entry, i) => <TimelineEntry entry={entry} isLast={i === visible.length - 1 && hidden.length === 0} />)}
        <div id="collapsed-timeline" class="timeline-collapsed collapsed">
          {hidden.map((entry, i) => (
            <TimelineEntry entry={entry} isLast={i === hidden.length - 1} />
          ))}
        </div>
      </div>
      <div class="mt-8 text-center">
        <button id="expand-timeline" class="btn-primary">
          <span>Expand Timeline</span>
          <svg class="w-4 h-4 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <button id="collapse-timeline" class="btn-primary hidden">
          <span>Collapse Timeline</span>
          <svg class="w-4 h-4 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"/></svg>
        </button>
      </div>
    </>
  ) : (
    <div id="timeline-container" class="space-y-0">
      {visible.map((entry) => <TimelineEntry entry={entry} isLast={false} />)}
      {hidden.map((entry, i) => (
        <TimelineEntry entry={entry} isLast={i === hidden.length - 1 && hidden.length > 0} />
      ))}
    </div>
  )
}

<script is:inline>
  function setupTimeline() {
    var expandBtn = document.getElementById('expand-timeline');
    var collapseBtn = document.getElementById('collapse-timeline');
    var collapsedTimeline = document.getElementById('collapsed-timeline');

    if (expandBtn && collapsedTimeline) {
      collapsedTimeline.classList.add('collapsed');

      var freshExpand = expandBtn.cloneNode(true);
      expandBtn.parentNode.replaceChild(freshExpand, expandBtn);

      var freshCollapse = null;
      if (collapseBtn) {
        freshCollapse = collapseBtn.cloneNode(true);
        collapseBtn.parentNode.replaceChild(freshCollapse, collapseBtn);
        freshCollapse.classList.add('hidden');

        freshCollapse.addEventListener('click', function() {
          collapsedTimeline.classList.add('collapsed');
          freshCollapse.classList.add('hidden');
          freshExpand.classList.remove('hidden');
        });
      }

      freshExpand.addEventListener('click', function() {
        collapsedTimeline.classList.remove('collapsed');
        freshExpand.classList.add('hidden');
        if (freshCollapse) freshCollapse.classList.remove('hidden');
      });
    }
  }

  setupTimeline();

  if (!document.body.dataset.timelineSwap) {
    document.body.dataset.timelineSwap = '1';
    document.addEventListener('astro:after-swap', setupTimeline);
  }
</script>
