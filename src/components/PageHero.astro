---
interface Props {
  title: string;
  subtitle?: string;
  gridOverlay?: boolean;
}

const { title, subtitle, gridOverlay = false } = Astro.props;
---

<section class:list={["pt-20 pb-20 text-center px-6 hero-section", { "hero-section--grid": gridOverlay }]}>
  <h1 class="text-3xl md:text-4xl lg:text-5xl font-serif font-bold mb-4 tracking-[0.05em] leading-[1.1] uppercase text-black relative inline-block after:content-[''] after:absolute after:-bottom-2 after:left-1/2 after:-translate-x-1/2 after:w-10 after:h-[3px] after:bg-black after:rounded-[2px]">{title}</h1>
  {subtitle && <p class="text-lg text-gray-600 max-w-xl mx-auto leading-relaxed">{subtitle}</p>}
  <slot name="after" />
</section>

<style>
  .hero-section--grid {
    position: relative;
  }

  .hero-section--grid::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background-image:
      linear-gradient(to right, rgba(0, 0, 0, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.04) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 70%);
  }

  .hero-section--grid > * {
    position: relative;
    z-index: 1;
  }
</style>
