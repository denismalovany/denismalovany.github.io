---
import { siteData } from '../data/site';

interface Props {
  currentPage?: string;
}

const { currentPage } = Astro.props;

const showResumeBtn = !!siteData.resumePdf;
const pdfLabel = siteData.resumePdf ? 'Download PDF' : 'Print / Save PDF';

const navItems = [
  { href: '/index.html', label: 'Home', key: 'home' },
  { href: '/about.html', label: 'About', key: 'about' },
  { href: '/projects.html', label: 'All Projects', key: 'projects' },
  { href: '/contact.html', label: 'Contact', key: 'contact' },
];

function isActive(key: string, current: string | undefined): boolean {
  if (!current) return false;
  if (current === key) return true;
  if (current === 'project-detail' && key === 'projects') return true;
  return false;
}

const pdfLinkClasses = 'inline-flex items-center gap-1 px-2.5 py-1 text-2xs font-medium text-gray-500 no-underline border border-gray-200 rounded-full transition duration-fast ml-1 tracking-[0.02em] uppercase hover:text-accent-500 hover:border-accent-300 hover:bg-accent-50';
const pdfIconClasses = 'w-3 h-3 shrink-0';
---

<header id="site-header" class="flex items-center justify-between px-6 md:px-8">
  <div class="flex items-center">
    <a href="/index.html" class="flex items-center space-x-2.5 group" aria-label="DM Portfolio — Home">
      <span class="text-2xl font-display font-extrabold gradient-text">DM</span>
      <span class="text-sm font-sans text-gray-400 group-hover:text-accent-500 transition-colors duration-fast relative top-[0.1em]">Portfolio</span>
    </a>
  </div>

  <div class="flex items-center gap-3">
    <nav aria-label="Main navigation" class="hidden md:flex items-center">
      <ul class="flex items-center space-x-1" role="list">
      {navItems.map(item => (
        <li>
          <a
            href={item.href}
            class={`relative transition-colors duration-fast text-sm font-medium no-underline px-3 py-2 rounded-lg${isActive(item.key, currentPage) ? ' text-accent-600 bg-accent-50 font-semibold' : ' text-gray-600 hover:text-accent-600 hover:bg-gray-50'}`}
            aria-current={isActive(item.key, currentPage) ? 'page' : undefined}
            data-astro-prefetch="hover"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
      <a href="javascript:window.print()" class={pdfLinkClasses} aria-label="Print / Save PDF" onclick="window.print();return false">
        <svg class={pdfIconClasses} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        <span>Print</span>
      </a>
  </nav>

    <button
      id="mobile-menu-toggle"
      class="md:hidden flex items-center justify-center w-10 h-10 rounded-lg hover:bg-gray-50 transition-colors duration-fast relative"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="hamburger-icon h-5 w-5 text-gray-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg class="close-icon h-5 w-5 text-gray-600 absolute hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
</header>

<div id="mobile-menu-backdrop" class="fixed top-[4.5rem] inset-x-0 bottom-0 bg-black/20 z-[998] backdrop-blur-sm" aria-hidden="true"></div>

<nav id="mobile-menu" class="fixed top-[4.5rem] inset-x-0 bg-white border-t border-gray-100 z-[999] overflow-hidden shadow-lg" aria-label="Mobile navigation" inert>
  <ul class="px-4 py-3 flex flex-col gap-1 list-none" role="list">
    {navItems.map(item => (
      <li>
        <a
          href={item.href}
          class={`relative transition-colors duration-fast block py-2.5 px-4 rounded-lg${isActive(item.key, currentPage) ? ' text-accent-600 bg-accent-50 font-semibold' : ' text-gray-600 hover:text-accent-600 hover:bg-gray-50'}`}
          aria-current={isActive(item.key, currentPage) ? 'page' : undefined}
        >
          {item.label}
        </a>
      </li>
    ))}
    <li>
      <a href="javascript:window.print()" class="block py-2.5 px-4 text-sm font-medium text-gray-600 hover:text-accent-600 rounded-lg" onclick="window.print();return false">
        <span>{pdfLabel}</span>
      </a>
    </li>
  </ul>
</nav>

<script>
  function setupMobileMenu() {
    const BREAKPOINT = 768;
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const backdrop = document.getElementById('mobile-menu-backdrop');
    if (!toggle || !menu) return;

    let isOpen = false;

    function open() {
      isOpen = true;
      menu.inert = false;
      toggle.classList.add('menu-open');
      toggle.setAttribute('aria-expanded', 'true');
      menu.classList.add('menu-open');
      if (backdrop) {
        backdrop.classList.add('menu-open');
        backdrop.setAttribute('aria-hidden', 'false');
      }
      document.body.classList.add('menu-locked');
    }

    function close() {
      isOpen = false;
      menu.inert = true;
      toggle.classList.remove('menu-open');
      toggle.setAttribute('aria-expanded', 'false');
      menu.classList.remove('menu-open');
      if (backdrop) {
        backdrop.classList.remove('menu-open');
        backdrop.setAttribute('aria-hidden', 'true');
      }
      document.body.classList.remove('menu-locked');
    }

    function onToggleClick() { isOpen ? close() : open(); }
    function onEscape(e) { if (e.key === 'Escape' && isOpen) { close(); toggle.focus(); } }
    function onResize() { if (window.innerWidth >= BREAKPOINT && isOpen) close(); }
    function onMenuClick(e) {
      const link = e.target.closest('a');
      if (link && link.getAttribute('href') !== 'javascript:window.print()') close();
    }

    close();

    toggle.addEventListener('click', onToggleClick);
    if (backdrop) backdrop.addEventListener('click', close);
    document.addEventListener('keydown', onEscape);
    window.addEventListener('resize', onResize);
    menu.addEventListener('click', onMenuClick);

    return function teardown() {
      close();
      toggle.removeEventListener('click', onToggleClick);
      if (backdrop) backdrop.removeEventListener('click', close);
      document.removeEventListener('keydown', onEscape);
      window.removeEventListener('resize', onResize);
      menu.removeEventListener('click', onMenuClick);
    };
  }

  let teardownMobileMenu = setupMobileMenu();

  document.addEventListener('astro:before-swap', () => {
    if (teardownMobileMenu) { teardownMobileMenu(); teardownMobileMenu = null; }
  });

  document.addEventListener('astro:after-swap', () => {
    teardownMobileMenu = setupMobileMenu();
  });
</script>
