---
import { siteData } from '../data/site';

interface Props {
  currentPage?: string;
}

const { currentPage } = Astro.props;

const resumeLink = siteData.resumePdf || 'javascript:window.print()';
const resumeLabel = siteData.resumePdf ? 'Download PDF' : 'Print / Save PDF';
const hasPdf = !!siteData.resumePdf;

const navItems = [
  { href: '/index.html', label: 'Home', key: 'home' },
  { href: '/about.html', label: 'About', key: 'about' },
  { href: '/projects.html', label: 'All Projects', key: 'projects' },
  { href: '/contact.html', label: 'Contact', key: 'contact' },
];

function isActive(key: string, current: string | undefined): boolean {
  if (!current) return false;
  if (current === key) return true;
  if (current === 'project-detail' && key === 'projects') return true;
  return false;
}
---
<header id="site-header" class="flex items-center justify-between px-6">
  <div class="flex items-center">
    <a href="/index.html" class="flex items-center space-x-2" aria-label="DM Portfolio — Home">
      <span class="text-2xl font-serif font-bold tracking-tight site-logo">DM</span>
      <span class="text-sm font-sans uppercase tracking-wider text-gray-500">Portfolio</span>
    </a>
  </div>

  <nav aria-label="Main navigation" class="hidden md:flex items-center">
    <ul class="flex items-center space-x-1" role="list">
      {navItems.map(item => (
        <li>
          <a
            href={item.href}
            class={`nav-link${isActive(item.key, currentPage) ? ' active' : ''}`}
            aria-current={isActive(item.key, currentPage) ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    {hasPdf ? (
      <a href={resumeLink} class="header-pdf-link" aria-label={resumeLabel}>
        <svg class="header-pdf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        <span>PDF</span>
      </a>
    ) : (
      <a href="javascript:window.print()" class="header-pdf-link" aria-label="Print / Save PDF" onclick="window.print();return false">
        <svg class="header-pdf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        <span>PDF</span>
      </a>
    )}
  </nav>

  <button
    id="mobile-menu-toggle"
    class="md:hidden flex items-center justify-center w-10 h-10 rounded hover:bg-gray-50 relative"
    aria-label="Toggle navigation menu"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <svg class="hamburger-icon h-5 w-5 text-gray-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
    <svg class="close-icon h-5 w-5 text-gray-600 absolute hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>
</header>

<div id="mobile-menu-backdrop" aria-hidden="true"></div>

<nav id="mobile-menu" aria-label="Mobile navigation" inert>
  <ul role="list">
    {navItems.map(item => (
      <li>
        <a
          href={item.href}
          class={`nav-link mobile-nav-link${isActive(item.key, currentPage) ? ' active' : ''}`}
          aria-current={isActive(item.key, currentPage) ? 'page' : undefined}
        >
          {item.label}
        </a>
      </li>
    ))}
    <li>
      {hasPdf ? (
        <a href={resumeLink} class="header-pdf-link header-pdf-link--mobile">
          <svg class="header-pdf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          <span>{resumeLabel}</span>
        </a>
      ) : (
        <a href="javascript:window.print()" class="header-pdf-link header-pdf-link--mobile" onclick="window.print();return false">
          <svg class="header-pdf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          <span>{resumeLabel}</span>
        </a>
      )}
    </li>
  </ul>
</nav>
