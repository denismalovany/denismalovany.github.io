---
import { siteData } from '../data/site';

interface Props {
  currentPage?: string;
}

const { currentPage } = Astro.props;

const resumeLink = siteData.resumePdf || 'javascript:window.print()';
const resumeLabel = siteData.resumePdf ? 'Download PDF' : 'Print / Save PDF';
const hasPdf = !!siteData.resumePdf;

const navItems = [
  { href: '/index.html', label: 'Home', key: 'home' },
  { href: '/about.html', label: 'About', key: 'about' },
  { href: '/projects.html', label: 'All Projects', key: 'projects' },
  { href: '/contact.html', label: 'Contact', key: 'contact' },
];

function isActive(key: string, current: string | undefined): boolean {
  if (!current) return false;
  if (current === key) return true;
  if (current === 'project-detail' && key === 'projects') return true;
  return false;
}

const pdfLinkClasses = 'inline-flex items-center gap-1 px-2 py-1 text-2xs font-medium text-gray-600 no-underline border border-gray-200 rounded-full transition duration-fast ml-1 tracking-[0.02em] uppercase hover:text-black hover:border-gray-400 hover:bg-gray-50';
const pdfIconClasses = 'w-3 h-3 shrink-0';
---

<header id="site-header" class="flex items-center justify-between px-6">
  <div class="flex items-center">
    <a href="/index.html" class="flex items-center space-x-2" aria-label="DM Portfolio — Home">
      <span class="text-2xl font-serif font-bold tracking-tight text-black">DM</span>
      <span class="text-sm font-sans uppercase tracking-wider text-gray-500">Portfolio</span>
    </a>
  </div>

  <nav aria-label="Main navigation" class="hidden md:flex items-center">
    <ul class="flex items-center space-x-1" role="list">
      {navItems.map(item => (
        <li>
          <a
            href={item.href}
            class={`relative transition-colors duration-fast text-sm font-medium no-underline px-3 py-2${isActive(item.key, currentPage) ? ' text-black font-semibold after:content-[\'\'] after:absolute after:bottom-0 after:left-2 after:right-2 after:h-0.5 after:bg-black' : ' text-gray-600 hover:text-black'}`}
            aria-current={isActive(item.key, currentPage) ? 'page' : undefined}
            data-astro-prefetch="hover"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    {hasPdf ? (
      <a href={resumeLink} class={pdfLinkClasses} aria-label={resumeLabel}>
        <svg class={pdfIconClasses} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        <span>PDF</span>
      </a>
    ) : (
      <a href="javascript:window.print()" class={pdfLinkClasses} aria-label="Print / Save PDF" onclick="window.print();return false">
        <svg class={pdfIconClasses} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        <span>PDF</span>
      </a>
    )}
  </nav>

  <button
    id="mobile-menu-toggle"
    class="md:hidden flex items-center justify-center w-10 h-10 rounded hover:bg-gray-50 relative"
    aria-label="Toggle navigation menu"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <svg class="hamburger-icon h-5 w-5 text-gray-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
    <svg class="close-icon h-5 w-5 text-gray-600 absolute hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>
</header>

<div id="mobile-menu-backdrop" class="fixed top-16 inset-x-0 bottom-0 bg-black/20 z-[998]" aria-hidden="true"></div>

<nav id="mobile-menu" class="fixed top-16 inset-x-0 bg-white border-t border-gray-100 z-[999] overflow-hidden shadow-md" aria-label="Mobile navigation" inert>
  <ul class="px-4 py-3 flex flex-col gap-1 list-none" role="list">
    {navItems.map(item => (
      <li>
        <a
          href={item.href}
          class={`relative transition-colors duration-fast block py-2.5 px-4${isActive(item.key, currentPage) ? ' text-black font-semibold after:content-[\'\'] after:absolute after:bottom-0 after:left-2 after:right-2 after:h-0.5 after:bg-black' : ' text-gray-600 hover:text-black'}`}
          aria-current={isActive(item.key, currentPage) ? 'page' : undefined}
        >
          {item.label}
        </a>
      </li>
    ))}
    <li>
      {hasPdf ? (
        <a href={resumeLink} class={`${pdfLinkClasses} ml-0 mt-2 px-4 py-2.5 text-sm tracking-normal normal-case`}>
          <svg class={pdfIconClasses} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          <span>{resumeLabel}</span>
        </a>
      ) : (
        <a href="javascript:window.print()" class={`${pdfLinkClasses} ml-0 mt-2 px-4 py-2.5 text-sm tracking-normal normal-case`} onclick="window.print();return false">
          <svg class={pdfIconClasses} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          <span>{resumeLabel}</span>
        </a>
      )}
    </li>
  </ul>
</nav>

<script is:inline>
  (function() {
    var BREAKPOINT = 768;
    var toggle = document.getElementById('mobile-menu-toggle');
    var menu = document.getElementById('mobile-menu');
    var backdrop = document.getElementById('mobile-menu-backdrop');
    if (!toggle || !menu) return;

    var isOpen = false;

    function open() {
      isOpen = true;
      toggle.classList.add('menu-open');
      toggle.setAttribute('aria-expanded', 'true');
      menu.classList.add('menu-open');
      menu.removeAttribute('inert');
      if (backdrop) {
        backdrop.classList.add('menu-open');
        backdrop.setAttribute('aria-hidden', 'false');
      }
      document.body.classList.add('menu-locked');
    }

    function close() {
      isOpen = false;
      toggle.classList.remove('menu-open');
      toggle.setAttribute('aria-expanded', 'false');
      menu.classList.remove('menu-open');
      menu.setAttribute('inert', '');
      if (backdrop) {
        backdrop.classList.remove('menu-open');
        backdrop.setAttribute('aria-hidden', 'true');
      }
      document.body.classList.remove('menu-locked');
    }

    toggle.addEventListener('click', function() {
      isOpen ? close() : open();
    });

    if (backdrop) {
      backdrop.addEventListener('click', function() {
        close();
      });
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && isOpen) {
        close();
        toggle.focus();
      }
    });

    window.addEventListener('resize', function() {
      if (window.innerWidth >= BREAKPOINT && isOpen) {
        close();
      }
    });

    menu.addEventListener('click', function(e) {
      var link = e.target.closest('a');
      if (link && link.getAttribute('href') !== 'javascript:window.print()') {
        close();
      }
    });
  })();
</script>
